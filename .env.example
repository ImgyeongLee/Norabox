# Neon Postgres connection string (the pooled "-pooler" URL works for the app and migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Recommended: Neon's direct (unpooled) URL — the same URL without "-pooler" in the host.
# `prisma migrate` uses it when set; migrations through the pooler can time out on Prisma's lock (P1002).
# DIRECT_URL=""
# Secret used to sign session cookies. Generate one with: openssl rand -hex 32
AUTH_SECRET=""
# YouTube Data API v3 key (https://console.cloud.google.com/apis/library/youtube.googleapis.com).
# Without it, search is disabled but pasting a YouTube link still works.
YOUTUBE_API_KEY=""

# --- Split deployment (app on Vercel, realtime server elsewhere) ---
# Vercel: public URL of the realtime server. Leave unset locally (same origin).
# NEXT_PUBLIC_SOCKET_URL="https://norabox-realtime.onrender.com"
# Realtime server: the app origin(s) allowed to connect, comma-separated.
# CLIENT_ORIGIN="https://norabox.vercel.app"

# --- Image storage (private S3 bucket; profile images go to images/avatars/<userId>) ---
# Needed by the Next.js app (local + Vercel), not by the realtime server.
# The IAM user needs s3:PutObject, s3:GetObject and s3:DeleteObject on arn:aws:s3:::<bucket>/images/*
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Cloudflare Turnstile (bot check on sign-up and log-in): https://dash.cloudflare.com → Turnstile.
# Leave both empty to turn it off (local dev). For local testing, Cloudflare's always-pass keys are
# 1x00000000000000000000AA (site key) and 1x0000000000000000000000000000000AA (secret key).
# The site key is baked in at build time: redeploy after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Upstash Redis (attempt limits per IP on sign-up and log-in). Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead, which also work. Leave empty for no limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Site admins, who can write posts on /announcements: account emails, comma-separated.
# Only list emails that already have an account (otherwise someone could sign up with it).
SITE_ADMIN_EMAILS=""

# Email address for the footer's "Contact" link (issue reports and questions). The link is hidden when unset.
CONTACT_EMAIL=""

# --- Using Supabase (or any standard Postgres) instead of Neon ---
# DATABASE_URL = Supabase "Transaction pooler" string (port 6543, keep ?pgbouncer=true)
# DIRECT_URL   = Supabase "Session pooler" string (port 5432), used by prisma migrate
# Supabase's CA certificate (Database → SSL configuration → Download), as PEM text,
# so the app verifies the database server. "\n" escapes are accepted for one-line values.
# DATABASE_CA_CERT=""
