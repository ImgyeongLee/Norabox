// Norabox data model (PostgreSQL on Neon).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  // "active" | "deleted". Deleting an account only flips this: the row and the
  // user's posts stay, and the author is shown as "Deleted user".
  status       String   @default("active")
  // Set when the user has a profile image; the image itself lives in S3 at
  // images/avatars/<id> (see src/lib/storage.ts).
  avatarMime   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
  rooms Room[]
  likes PostLike[]
}

model Room {
  id                String   @id @default(cuid())
  // Room name exactly as typed; it doubles as the invite code.
  code              String
  // Lowercased code, used for lookups so invite codes are case-insensitive.
  slug              String   @unique
  // Secret anonymous id of the browser that created the room.
  ownerClientId     String
  ownerUserId       String?
  owner             User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  masterVolume      Int      @default(100)
  // "none" | "one" | "all"
  loopMode          String   @default("none")
  // Color theme chosen by the owner at creation: "default" | "mono" | "starry".
  theme             String   @default("default")
  // Closed by the admin: nobody new can join. Only the admin, DJs and the people who were
  // in the room when it was closed (`allowedIdentities`, "u:<userId>" / "c:<clientId>") get in.
  locked            Boolean  @default(false)
  allowedIdentities String[] @default([])
  currentItemId     String?
  // Refreshed while anyone is in the room or anything changes. Rooms idle for
  // 6 hours are deleted (see src/lib/rooms.ts).
  lastActiveAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items PlaylistItem[]
  djs   RoomDj[]

  @@index([lastActiveAt])
}

model PlaylistItem {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  videoId     String
  title       String
  channel     String
  thumbnail   String
  durationSec Int?
  position    Int
  addedBy     String
  // Admin-only cue, e.g. "Play when the party enters the crypt". Never sent to other members.
  memo        String?
  // Hidden by the admin as a surprise: only the admin sees it until the admin plays it.
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([roomId, position])
}

// Members promoted to DJ. `identity` is "u:<userId>" for signed-in users,
// or "c:<clientId>" for anonymous visitors.
model RoomDj {
  roomId   String
  room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  identity String

  @@id([roomId, identity])
}

// A TRPG scenario that posts are written for. Identified by name + writer
// (case-insensitive), so posts about the same scenario are grouped together.
model Scenario {
  id        String   @id @default(cuid())
  name      String
  // null when the writer is unknown.
  writer    String?
  // Normalised (trimmed, lowercased) copies used for matching and uniqueness.
  nameKey   String
  writerKey String   @default("")
  createdAt DateTime @default(now())

  posts Post[]

  @@unique([nameKey, writerKey])
}

model Post {
  id         String    @id @default(cuid())
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  // "private" (only the author) | "unlisted" (anyone with the share link) | "public" (on the forum).
  visibility String    @default("private")
  // Secret for the share link /s/<shareToken>; different from the post's own URL.
  // Resetting it invalidates links shared earlier.
  shareToken String    @unique
  // Optional: a post doesn't have to be about a particular scenario.
  scenarioId String?
  scenario   Scenario? @relation(fields: [scenarioId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tracks PostTrack[]
  likes  PostLike[]

  @@index([createdAt])
  @@index([scenarioId])
  @@index([visibility, createdAt])
  @@index([authorId, updatedAt])
}

// A signed-in user's like on a post; their liked posts form the "Liked playlists" list.
model PostLike {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt])
}

model PostTrack {
  id          String  @id @default(cuid())
  postId      String
  post        Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  videoId     String
  title       String
  // The video owner (YouTube channel name).
  channel     String
  thumbnail   String
  durationSec Int?
  // The author's private cue ("play when the party enters the crypt"); only the author sees it,
  // and it becomes the song's memo when they add the playlist to a room. Up to MAX_MEMO
  // characters for new edits; older posts may have longer ones. The column keeps its old name.
  memo        String?  @map("description")
  position    Int

  @@index([postId, position])
}

// A post on the announcements page. Only site admins (SITE_ADMIN_EMAILS) can write them.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  // Markdown.
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
